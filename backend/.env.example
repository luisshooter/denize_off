# Banco de dados (Neon, Railway Postgres, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Gere com: node -e "require('crypto').randomBytes(64).toString('hex')|console.log"
JWT_SECRET=gere_64_bytes_aleatorios_aqui
JWT_REFRESH_SECRET=gere_outros_64_bytes_aleatorios_aqui

# Porta (Railway/Render definem automaticamente via variável PORT)
PORT=3005

# production em produção, development local
NODE_ENV=production

# URLs do frontend após deploy (separadas por vírgula, sem barra no final)
ALLOWED_ORIGINS=https://seu-admin.vercel.app,https://sua-vitrine.vercel.app

# Credenciais do admin inicial (rode npm run seed uma vez após deploy)
ADMIN_EMAIL=seu@email.com
ADMIN_PASSWORD=SenhaForte#Aqui
